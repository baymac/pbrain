.env
.env.local
*.log
# Per-machine Claude Code local settings (permissions, etc.)
.claude/settings.local.json
.gbrain/
.DS_Store
.context/
.fastembed_cache/
.logs/
.gstack/
# Serena MCP per-project workspace (symbol cache, config, memories) — tool-
# generated, regenerated on each run; never committed.
.serena/
# Compiled helper apps (notify / overlay / reminders / tracker / groom) — per-machine
# build artifacts compiled from lib/*.swift, normally built to ~/.config/pbrain; never
# commit one if its PBRAIN_*_APP override ever points in-tree.
pbrain-*.app/
# Promo video raw renders — build artifacts; compressed copy lives in docs/media/
promo-video/renders/

# Python bytecode cache (lib/habit_schedule.py etc.)
__pycache__/
*.pyc

# Local Plane self-host stack (docker-compose + plane.env with secrets);
# created/managed by /init-plane + /project-manager, never committed.
plane-app/

# Serena MCP tool metadata/cache (editor tooling, not project work)
.serena/
